DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=false

# Optional Claude vision analysis. Keep the key only in .env or a secrets manager.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ENABLED=false

# Leave DB_HOST empty to use local SQLite. Set these values for PostgreSQL.
DB_NAME=baybuild
DB_USER=baybuild
DB_PASSWORD=baybuild
DB_HOST=
DB_PORT=5432
